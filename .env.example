# URL et clé publique du projet Supabase (Connect ou Settings > API Keys)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key

# Clé serveur exclusivement utilisée par l'endpoint n8n. Ne jamais exposer au navigateur.
SUPABASE_SECRET_KEY=sb_secret_your-key

# Identifiant du profil à afficher temporairement avant l'ajout de l'authentification.
# À remplacer ensuite par l'identifiant fourni par Supabase Auth.
JOBFLOW_DEMO_USER_ID=00000000-0000-0000-0000-000000000000

# Secret partagé uniquement côté serveur pour les appels provenant de n8n.
# Ne jamais exposer cette valeur dans NEXT_PUBLIC_*. 
N8N_JOBFLOW_WEBHOOK_SECRET=replace-with-a-long-random-secret
